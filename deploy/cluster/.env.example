# deploy.py init generates runtime/.env with distinct random credentials.
# This file documents the supported variables; use generated values for deployment.
PACKETIA_PROJECT_NAME=packetia
PACKETIA_IMAGE=packetia-cluster:local
PACKETIA_BUILD_JOBS=2
PACKETIA_JWT_ISSUER=packetia
PACKETIA_JWT_SECRET=GENERATED_BY_DEPLOY_INIT
PACKETIA_NODE_A_SECRET=GENERATED_BY_DEPLOY_INIT
PACKETIA_NODE_B_SECRET=GENERATED_BY_DEPLOY_INIT
PACKETIA_PUBLIC_IP=127.0.0.1
PACKETIA_DOMAIN=
